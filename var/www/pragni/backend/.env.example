# Server
PORT=5000
NODE_ENV=production

# MongoDB (Internal VPC IP of DB EC2)
MONGO_URI=mongodb://PRIVATE_DB_EC2_IP:27017/pragni

# JWT Secrets (generate strong random strings)
JWT_SECRET=CHANGE_THIS_TO_RANDOM_256BIT_STRING
JWT_ADMIN_SECRET=CHANGE_THIS_DIFFERENT_RANDOM_STRING
JWT_EXPIRE=7d

# Admin Panel Secret Route (CHANGE THIS - this is the hidden URL path)
ADMIN_SECRET_PATH=xK9mP2qR7nL4wV

# YouTube Salting Key (for obfuscating video IDs)
VIDEO_SALT_KEY=CHANGE_THIS_RANDOM_KEY_32CHARS

# Google Drive Salt
DRIVE_SALT_KEY=CHANGE_THIS_ANOTHER_RANDOM_KEY

# CORS Allowed Origins
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Rate Limiting
MAX_REQUESTS_PER_15MIN=100
